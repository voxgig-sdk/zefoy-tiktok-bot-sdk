
# Go MCP server target — a Go program that *consumes* the sibling Go
# SDK and exposes it as MCP tools. Like go-cli, it is not a language
# SDK in its own right, so the standard per-entity / per-feature /
# readme / test generation phases are switched off via the `phase`
# map below.

main: kit: target: 'go-mcp': {

  title: 'Go MCP server'
  ext: go
  comment: line: "//"
  module: name: 'zefoy-tiktok-bot'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'

  # Per-generation-phase activation. Mirrors go-cli — only Main runs.
  phase: {
    entity:     { active: false }
    feature:    { active: false }
    readme:     { active: false }
    agentguide: { active: false }
    test:       { active: false }
  }

  # No external module deps declared here. The generated go.mod uses
  # a relative replace to the sibling SDK at ../go and declares the
  # MCP Go SDK as a direct dep. See Main_go-mcp.ts.
  deps: {}
}


# Feature-deps map slot — every target carries this so the same
# feature can specify per-target dep variants.
main: kit: feature: &: target: 'go-mcp': deps: &: {
  kind: *'prod' | string
}


# Publication: tag-only — the Go module proxy resolves versions from the
# go-mcp/vX.Y.Z GitHub tag; there is no package registry to upload to.
#
# `target add <t>` OVERWRITES this file, so a project must never set its
# publication values here — voxgig-solardemo-sdk lost its pinned npm package
# name exactly that way. Set them in the project's own model
# (`model/sdk.aontu`), where they survive a resync.
#
# For that to work this file must LEAVE THOSE KEYS UNSET: in aontu a concrete
# value does not yield to another concrete value, it CONFLICTS, and two
# defaults conflict too. The schema (@voxgig/sdkgen/model/sdkgen.aontu)
# already defaults `tag.active`, `registry.state`, `registry.active` and
# `registry.package`, so a project's concrete value wins over the default and
# repeating them here would only take that away.
#
# What remains below is per-target registry IDENTITY, which is not a project
# choice and stays concrete.
main: kit: target: 'go-mcp': publish: {
  tag: { via: 'root' }
}
